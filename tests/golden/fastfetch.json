"// Template: rendered to ~/.config/fastfetch/config.jsonc by ~/.config/plasma-rice/apps.py.\n// {{name}} = palette colour as #hex, {{name.rgb}} = r;g;b for fastfetch's {#38;2;...} colour codes,\n// /x.png / kitty = the logo apps.py picked (a rounded square of the wallpaper over the kitty\n// image protocol, which Konsole speaks; Clawd as text art otherwise), #73daca = the palette colour\n// furthest in hue from primary and tertiary, so the three sections never blur together.\n{\n  \"$schema\": \"https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json\",\n  \"logo\": {\n    \"type\": \"kitty\",\n    \"source\": \"/x.png\",\n    \"width\": 20,\n    \"preserveAspectRatio\": true,\n    \"padding\": { \"top\": 1, \"left\": 2, \"right\": 3 }\n  },\n  \"display\": {\n    \"separator\": \"  \",\n    \"color\": { \"keys\": \"#c7ccc8\", \"output\": \"#dfe2e0\", \"title\": \"#c7ccc8\" },\n    \"key\": { \"width\": 13 },\n    \"percent\": { \"color\": { \"green\": \"#9ece6a\", \"yellow\": \"#e0af68\", \"red\": \"#f7768e\" } }\n  },\n  \"modules\": [\n    { \"type\": \"title\", \"format\": \"{#1;38;2;199;204;200}{user-name}{#0;38;2;119;124;120} @ {#1;38;2;174;179;174}{host-name}\" },\n    \"break\",\n    { \"type\": \"custom\", \"format\": \"{#38;2;99;103;100}╭─ {#1;38;2;199;204;200}system {#0;38;2;99;103;100}───────────────────────────\" },\n    { \"type\": \"os\",       \"key\": \"{#38;2;99;103;100}│ {#38;2;199;204;200}󰣇  os\",     \"format\": \"{pretty-name}\" },\n    { \"type\": \"kernel\",   \"key\": \"{#38;2;99;103;100}│ {#38;2;199;204;200}  kernel\", \"format\": \"{release}\" },\n    { \"type\": \"uptime\",   \"key\": \"{#38;2;99;103;100}│ {#38;2;199;204;200}󰅐  uptime\" },\n    { \"type\": \"packages\", \"key\": \"{#38;2;99;103;100}│ {#38;2;199;204;200}󰏖  pkgs\" },\n    { \"type\": \"custom\", \"format\": \"{#38;2;99;103;100}├─ {#1;38;2;174;179;174}desktop {#0;38;2;99;103;100}──────────────────────────\" },\n    { \"type\": \"de\",       \"key\": \"{#38;2;99;103;100}│ {#38;2;174;179;174}  de\" },\n    { \"type\": \"wm\",       \"key\": \"{#38;2;99;103;100}│ {#38;2;174;179;174}  wm\" },\n    { \"type\": \"terminal\", \"key\": \"{#38;2;99;103;100}│ {#38;2;174;179;174}  term\" },\n    { \"type\": \"shell\",    \"key\": \"{#38;2;99;103;100}│ {#38;2;174;179;174}  shell\" },\n    { \"type\": \"custom\", \"format\": \"{#38;2;99;103;100}├─ {#1;38;2;115;218;202}hardware {#0;38;2;99;103;100}─────────────────────────\" },\n    { \"type\": \"cpu\",      \"key\": \"{#38;2;99;103;100}│ {#38;2;115;218;202}  cpu\",    \"format\": \"{name}\" },\n    { \"type\": \"gpu\",      \"key\": \"{#38;2;99;103;100}│ {#38;2;115;218;202}󰢮  gpu\",    \"format\": \"{name}\" },\n    { \"type\": \"memory\",   \"key\": \"{#38;2;99;103;100}│ {#38;2;115;218;202}󰍛  mem\" },\n    { \"type\": \"disk\",     \"key\": \"{#38;2;99;103;100}│ {#38;2;115;218;202}󰋊  disk\",   \"folders\": \"/\", \"format\": \"{size-used} / {size-total} ({size-percentage})\" },\n    { \"type\": \"custom\", \"format\": \"{#38;2;99;103;100}╰────────────────────────────────────\" },\n    \"break\",\n    { \"type\": \"colors\", \"symbol\": \"circle\", \"paddingLeft\": 2 }\n  ]\n}\n"
