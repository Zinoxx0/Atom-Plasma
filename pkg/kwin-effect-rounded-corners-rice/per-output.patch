+
+void ShapeCorners::WindowConfig::reloadOutputColors()
+{
+    s_outputColors.clear();
+    const auto cfg = KSharedConfig::openConfig(QStringLiteral("kwinrc"), KConfig::NoGlobals);
+    cfg->reparseConfiguration();
+    const auto        base   = cfg->group(QStringLiteral("Round-Corners"));
+    const static auto prefix = QStringLiteral("Output ");
+    for (const auto &name : base.groupList()) {
+        if (!name.startsWith(prefix)) {
+            continue;
+        }
+        const auto group = base.group(name);
+        s_outputColors.insert(name.mid(prefix.size()),
+                              OutputColors{.outline  = group.readEntry("OutlineColor", Config::outlineColor()),
+                                           .outline2 = group.readEntry("OutlineColor2", Config::outlineColor2()),
+                                           .inactive = group.readEntry("InactiveOutlineColor",
+                                                                       Config::inactiveOutlineColor())});
+    }
+}
+
+void ShapeCorners::WindowConfig::applyOutputColors(const QString &output, const bool active)
+{
+    const auto colors = s_outputColors.constFind(output);
+    if (colors == s_outputColors.constEnd()) {
+        return;
+    }
+    if (active) {
+        if (Config::activeOutlineUsePalette()) {
+            return;
+        }
+        outline.color1 = FloatColor(colors->outline);
+        outline.color1.setAlpha(Config::activeOutlineAlpha());
+        outline.color2 = Config::outlineIsGradient() ? FloatColor(colors->outline2) : outline.color1;
+    } else {
+        if (Config::inactiveOutlineUsePalette()) {
+            return;
+        }
+        outline.color1 = FloatColor(colors->inactive);
+        outline.color1.setAlpha(Config::inactiveOutlineAlpha());
+        outline.color2 = outline.color1;
+    }
+}
